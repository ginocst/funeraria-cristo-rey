# Variables de entorno para desarrollo local
# En producción no se utiliza, ya que las variables llegan desde infra/ecs/contenedor.json
# y los secretos (DB_PASSWORD, APP_KEY) desde AWS Secrets Manager

APP_NAME="Funeraria Cristo Rey"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=funeraria
DB_USERNAME=funeraria
DB_PASSWORD=funeraria
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# SPA autorizada (CORS + cookies de Sanctum)
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Verificación en dos pasos obligatoria para Administrador y Coordinador
# En producción siempre true
MFA_OBLIGATORIO=false
SESION_ABSOLUTA_MINUTOS=480

# Carga de datos de demostración con "php artisan migrate --seed" (sólo en desarrollo)
SEED_DEMO=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@cristorey.test"
MAIL_FROM_NAME="${APP_NAME}"

# los archivos "local" apuntan a s3 en produccion
ARCHIVOS_DRIVER=local
CATALOGO_DRIVER=local
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_ARCHIVOS=
AWS_BUCKET_FRONTEND=
CATALOGO_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
